{%- comment -%}
  Fires GA4 `generate_lead` on the thank-you page.

  When the contact form is served by Bloom, the submission happens inside a
  cross-origin iframe, so the theme can't observe it. Bloom instead redirects to
  this page on submit — arriving here IS the conversion.

  Same measurement ID and the same send_page_view:false bootstrap as
  assets/contact-form-tracking.js. GA4 on this store is a sandboxed Shopify web
  pixel, so gtag() is not reachable from theme scope and we load our own.
  `generate_lead` is the identical event name the native form fires, so the two
  paths report into one conversion either way.
{%- endcomment -%}

<script>
  (function () {
    if (window.lzLeadTracked) return;
    window.lzLeadTracked = true;

    /* Arriving here is the conversion, but a refresh or a back-navigation
       re-renders the same page. window.lzLeadTracked only survives one load, so
       both GA4 and Meta counted the reload as a second lead. Trade-off noted:
       this snippet only renders on the thank-you page, so it cannot clear the
       flag elsewhere -- a genuine second booking in the same session is
       suppressed. Far rarer than a refresh. */
    var BLOOM_FLAG = 'lz_bloom_lead_fired';
    try {
      if (sessionStorage.getItem(BLOOM_FLAG)) return;
      sessionStorage.setItem(BLOOM_FLAG, '1');
    } catch (e) {}

    var GA_ID = 'G-NL5P1911ZX';

    function gtag() {
      (window.dataLayer = window.dataLayer || []).push(arguments);
    }

    // The store already runs a main-frame gtag for this stream on most pages —
    // reuse it rather than configuring the same measurement ID twice.
    if (!(window.google_tag_manager && window.google_tag_manager[GA_ID])) {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', GA_ID, { send_page_view: false });
    }

    var src = 'direct';
    var landing = '';
    try {
      src = sessionStorage.getItem('lz_src') || 'direct';
      landing = sessionStorage.getItem('lz_landing') || '';
    } catch (e) {}

    gtag('event', 'generate_lead', {
      form_id: 'contact',
      form_provider: 'bloom',
      lead_source: src,
      landing_page: landing,
      page_location: location.href,
      page_path: location.pathname,
      page_title: document.title
    });

    /* Meta Lead, alongside the GA4 event.

       Two things have to be true before this can fire, and neither is true when
       this script first runs: the Facebook pixel is delivered by Shopify's async
       web-pixels-manager, so window.fbq is still undefined at parse time, and the
       customer-privacy API resolves separately. So wait for both rather than
       testing once and giving up -- the earlier version tested `typeof fbq ===
       "function"` immediately and silently dropped every Lead.

       Fails closed on consent: if the privacy API has not resolved yet we keep
       waiting rather than sending, and if it resolves to "marketing not allowed"
       we never send at all. A theme-level fbq call bypasses the privacy layer
       Shopify's own web pixels sit behind, so this has to gate itself.

       Why it exists: Meta had no lead signal. Its only conversion event was
       Purchase, which this store almost never fires -- custom work is invoiced off
       Shopify, consultations book through Bloom without a checkout, and the gallery
       products have no add-to-cart. */
    function metaLead(params) {
      var tries = 0;
      (function attempt() {
        var cp = window.Shopify && window.Shopify.customerPrivacy;
        var consentKnown = cp && typeof cp.marketingAllowed === 'function';
        if (consentKnown && !cp.marketingAllowed()) return;
        if (consentKnown && typeof window.fbq === 'function') {
          try { window.fbq('track', 'Lead', params); } catch (e) {}
          return;
        }
        if (++tries > 40) return;
        setTimeout(attempt, 250);
      })();
    }
    metaLead({ content_name: 'consultation booking' });
  })();
</script>
