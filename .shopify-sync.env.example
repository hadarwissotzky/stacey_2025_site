# Copy to .shopify-sync.env (gitignored) and fill in. Auth is done ONCE here, not per session.
# Theme Access token from Shopify admin -> Apps -> "Theme Access" app. Starts with shptka_.
# This lets `shopify theme pull/push` run headless — no interactive login, no OAuth dance.
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Defaults below are for lorinczi.com. Override per store (e.g. painted-lady) as needed.
SHOPIFY_STORE=1fb93f.myshopify.com
SHOPIFY_THEME=163348971803
