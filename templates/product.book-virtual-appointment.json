        "custom_liquid": "<style>\n  /* Reserve the booking widget's height. The Bloom script empties its own\n     container and a Bloom stylesheet sets display:none on it while mounting,\n     so min-height cannot live on [data-bloom-form-id] - it collapses anyway.\n     This wrapper is ours and Bloom never touches it. Measured iframe heights:\n     487px @390w, 445px @412w, 539px @768w, 508px @1440w. */\n  .lorinczi-bloom-reserve { min-height: 500px; }\n  @media screen and (min-width: 750px) {\n    .lorinczi-bloom-reserve { min-height: 560px; }\n  }\n</style>\n<div class=\"lorinczi-bloom-reserve\">\n<div data-bloom-form-id=\"kxe70ojj87o4z\">\n  <script>\n    window.bloomSettings = {\n      userId: \"kj49qmyz17l12\",\n      profileId: \"ekl7z68o496mz\"\n    };\n\n    if (typeof bloomScript === \"undefined\") {\n      var bloomScript = document.createElement(\"script\");\n      bloomScript.async = true;\n\n      fetch(\"https://code.bloom.io/version?t=\" + Date.now())\n        .then(function(t) {\n          return t.text();\n        })\n        .then(function(t) {\n          bloomScript.src = \"https://code.bloom.io/widget.js?v=\" + t;\n          document.head.appendChild(bloomScript);\n        });\n    }\n  </script>\n</div>\n</div>\n\n<script>\n(function () {\n  const BLOOM_FORM_ID = \"kxe70ojj87o4z\";\n\n  const BLOOM_CONTAINER_WIDTH = \"54rem\";\n  const BLOOM_PADDING_TOP = \"20px\";\n  const BLOOM_PADDING_BOTTOM = \"20px\";\n  const BLOOM_BUTTON_WIDTH = \"19rem\";\n  const BLOOM_FIRST_BUTTON_TEXT = \"Book now\";\n\n  function applyBloomStyles() {\n    const wrapper = document.querySelector(\n      '[data-bloom-form-id=\"' + BLOOM_FORM_ID + '\"]'\n    );\n\n    if (!wrapper) return;\n\n    const iframe = wrapper.querySelector(\n      'iframe[data-testid=\"direct-embedded-iframe\"]'\n    );\n\n    if (!iframe) return;\n\n    try {\n      const doc =\n        iframe.contentDocument ||\n        iframe.contentWindow.document;\n\n      if (!doc || !doc.head) return;\n\n      let style = doc.getElementById(\"lorinczi-bloom-overrides\");\n\n      if (!style) {\n        style = doc.createElement(\"style\");\n        style.id = \"lorinczi-bloom-overrides\";\n        doc.head.appendChild(style);\n      }\n\n      style.textContent = `\n\n        :root {\n          --container-3xl: ${BLOOM_CONTAINER_WIDTH} !important;\n          --font-heading-scale: 1 !important;\n        }\n\n        .max-w-3xl {\n          width: 100% !important;\n          max-width: var(--container-3xl) !important;\n        }\n\n        .font-regular.container.max-w-3xl {\n          padding-top: 0 !important;\n          padding-bottom: 0 !important;\n        }\n\n        [data-testid=\"question-intro\"] {\n          padding-top: ${BLOOM_PADDING_TOP} !important;\n          padding-bottom: ${BLOOM_PADDING_BOTTOM} !important;\n        }\n\n        /* TITLE — MATCH SHOPIFY */\n        #quote-request-headline h1 {\n          font-size: calc(var(--font-heading-scale) * 1.4rem) !important;\n          font-family: \"Nexa\", \"Nexa Light\", sans-serif !important;\n          font-weight: 300 !important;\n          text-transform: uppercase !important;\n        }\n\n        [data-testid=\"question-intro\"] .mt-12.flex.justify-center {\n          width: 100% !important;\n          display: flex !important;\n          justify-content: center !important;\n        }\n\n        [data-testid=\"question-intro\"] .relative.inline-flex.items-center {\n          width: 100% !important;\n          max-width: ${BLOOM_BUTTON_WIDTH} !important;\n          display: flex !important;\n        }\n\n        [data-testid=\"next-button\"] {\n          width: 100% !important;\n          max-width: 100% !important;\n          min-width: 0 !important;\n\n          height: auto !important;\n          min-height: 40px !important;\n\n          padding: 10px 30px !important;\n\n          background: #402242 !important;\n          color: #ffffff !important;\n\n          border: 0 !important;\n          border-radius: 0 !important;\n\n          font-family: 'A Gothic', sans-serif !important;\n          font-size: 11px !important;\n          font-weight: 400 !important;\n\n          text-transform: uppercase !important;\n          letter-spacing: 1px !important;\n\n          line-height: 1.2 !important;\n          box-sizing: border-box !important;\n        }\n\n        [data-testid=\"next-button\"] > div {\n          font-family: 'A Gothic', sans-serif !important;\n          font-size: 11px !important;\n          font-weight: 400 !important;\n          text-transform: uppercase !important;\n          letter-spacing: 1px !important;\n          line-height: 1.2 !important;\n          color: #ffffff !important;\n        }\n\n        [data-testid=\"next-button\"] svg {\n          display: none !important;\n        }\n\n      `;\n\n      const firstButton = doc.querySelector(\n        '[data-testid=\"question-intro\"] [data-testid=\"next-button\"]'\n      );\n\n      if (firstButton) {\n        const buttonInner = firstButton.querySelector(\"div\");\n\n        if (buttonInner) {\n          const textNode = Array.from(buttonInner.childNodes).find(\n            function(node) {\n              return node.nodeType === 3;\n            }\n          );\n\n          if (textNode) {\n            textNode.nodeValue = BLOOM_FIRST_BUTTON_TEXT;\n          }\n        }\n      }\n\n    } catch (error) {\n      console.error(\"Could not style Bloom form:\", error);\n    }\n  }\n\n  const observer = new MutationObserver(function() {\n    applyBloomStyles();\n  });\n\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true\n  });\n\n  applyBloomStyles();\n\n  setTimeout(applyBloomStyles, 300);\n  setTimeout(applyBloomStyles, 750);\n  setTimeout(applyBloomStyles, 1500);\n\n})();\n</script>",
