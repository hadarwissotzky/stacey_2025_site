cal-align:.36em;margin-left:2px;\n  }\n  .lz-calc .lz-note{font-size:13.5px !important;line-height:1.4 !important;color:var(--lz-soft);margin:0;}\n \n  .lz-calc .lz-compare{\n    margin:26px auto 0;max-width:410px;text-align:left;\n    border-top:1px solid var(--lz-line);padding-top:20px;\n  }\n  .lz-calc .lz-compare[hidden]{display:none;}\n  .lz-calc .lz-bar-row{margin-bottom:12px;}\n  .lz-calc .lz-bar-top{\n    display:flex;justify-content:space-between;align-items:baseline;\n    font-size:11.5px;letter-spacing:.05em;margin-bottom:5px;color:var(--lz-soft);\n  }\n  .lz-calc .lz-bar-top b{\n    font-weight:700;color:var(--lz-ink);font-variant-numeric:tabular-nums;font-size:13.5px;\n  }\n  .lz-calc .lz-bar{height:6px;background:#ece3d5;overflow:hidden;}\n  .lz-calc .lz-bar span{display:block;height:100%;width:0;transition:width .5s cubic-bezier(.4,0,.2,1);}\n  .lz-calc .lz-bar.lz-mine span{background:var(--lz-gold);}\n  .lz-calc .lz-bar.lz-new span{background:#cdc1ae;}\n  .lz-calc .lz-saving{font-size:14px;color:var(--lz-gold-deep);margin:14px 0 0;text-align:center;line-height:1.45;}\n \n  .lz-calc .lz-incl{\n    margin:24px auto 0;max-width:460px;\n    border-top:1px solid var(--lz-line);padding-top:18px;\n    font-size:12.5px;color:var(--lz-soft);line-height:1.7;\n  }\n  .lz-calc .lz-incl b{\n    display:block;font-weight:400;color:var(--lz-ink);\n    font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;margin-bottom:6px;\n  }\n  .lz-calc .lz-cta{\n    display:inline-block;margin-top:24px;\n    font-size:12px;letter-spacing:.2em;text-transform:uppercase;\n    background:var(--lz-gold-deep);color:#fff;\n    text-decoration:none;padding:16px 34px;cursor:pointer;\n    transition:background .16s ease;\n  }\n  .lz-calc .lz-cta:hover{background:var(--lz-ink);color:#fff;}\n  .lz-calc .lz-timeline{font-size:12px !important;line-height:1.4 !important;color:var(--lz-soft);margin:14px 0 0;}\n  /* Matched to the page's body copy (#MainContent .main-page-title ~ .rte p,\n     set in custom_liquid_U4fpLV as 400 1.6rem/25px GoudyOldStyle). !important is\n     needed because base.css sets `#MainContent li, #MainContent p` at\n     calc(var(--font-heading-scale) * 2.2rem) — id-level specificity, which beat\n     this rule's 11px and rendered the disclaimer at 22px. */\n  .lz-calc #lz-led-credit{color:#5c7a52;}\n  .lz-calc .lz-swing{margin:12px 0 2px;}\n  .lz-calc .lz-swing-bar{display:flex;height:9px;border-radius:5px;overflow:hidden;background:var(--lz-line);}\n  .lz-calc .lz-swing-back{background:#5c7a52;}\n  .lz-calc .lz-swing-pay{background:var(--lz-gold);}\n  .lz-calc .lz-swing-ends{display:flex;justify-content:space-between;margin-top:7px;font-size:1.35rem;}\n  .lz-calc #lz-swing-l{color:#5c7a52;font-weight:700;}\n  .lz-calc #lz-swing-r{color:var(--lz-soft);}\n  .lz-calc .lz-back #lz-led-net,\n  .lz-calc .lz-back #lz-led-net-label,\n  .lz-calc .lz-back .lz-price,\n  .lz-calc .lz-back .lz-result-label{color:#5c7a52;}\n  .lz-calc .lz-back .lz-led-back{color:#5c7a52;font-style:normal;font-weight:600;opacity:1;}\n  .lz-calc .lz-ledger{margin:14px 0 4px;padding:12px 0;border-top:1px solid rgba(0,0,0,.12);border-bottom:1px solid rgba(0,0,0,.12);}\n  .lz-calc .lz-led-row{display:flex;justify-content:space-between;gap:12px;font-size:1.5rem;line-height:1.7;}\n  .lz-calc .lz-led-total{font-weight:700;border-top:1px solid rgba(0,0,0,.12);margin-top:6px;padding-top:6px;}\n  .lz-calc .lz-led-back{margin:8px 0 0;font-size:1.4rem;font-style:italic;opacity:.85;}\n  .lz-calc .lz-gold-explain{margin:14px 0 0;font:400 1.8rem/25px \"GoudyOldStyle\" !important;opacity:.95;color:var(--lz-ink);}\n  .lz-calc .lz-fine{\n    font-size:1.6rem !important;color:var(--lz-soft);text-align:center;\n    line-height:25px !important;margin:0;padding:16px 40px 20px;background:var(--lz-shell);\n  }\n  .lz-calc .lz-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}\n \n  .lz-calc .lz-sticky{\n    display:none;position:fixed;left:0;right:0;bottom:0;z-index:60;\n    background:var(--lz-shell);color:var(--lz-ink);\n    border-top:1px solid var(--lz-line);\n    padding:11px 14px;align-items:center;gap:12px;\n    box-shadow:0 -2px 16px rgba(58,51,44,.10);\n  }\n  .lz-calc .lz-sticky-l{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--lz-soft);display:block;}\n  .lz-calc .lz-sticky.lz-back .lz-sticky-l,\n  .lz-calc .lz-sticky.lz-back .lz-sticky-v{color:#5c7a52;}\n  .lz-calc .lz-sticky.lz-back{border-top-color:#5c7a52;}\n  .lz-calc .lz-sticky-v{\n    font-size:21px;font-weight:700;color:var(--lz-ink);\n    font-variant-numeric:tabular-nums;display:block;line-height:1.2;\n  }\n  .lz-calc .lz-sticky-v .lz-dash{color:var(--lz-gold);padding:0 3px;font-weight:400;}\n  .lz-calc .lz-sticky-v .lz-plus{display:none;}\n  .lz-calc .lz-sticky-b{\n    margin-left:auto;flex:0 0 auto;cursor:pointer;border:none;\n    background:var(--lz-gold-deep);color:#fff;\n    font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;padding:12px 16px;\n  }\n \n  @media (max-width:600px){\n    .lz-calc .lz-body{padding:30px 20px 26px;}\n    .lz-calc .lz-result{padding:28px 20px 26px;}\n    .lz-calc .lz-fine{padding:14px 20px 18px;}\n    .lz-calc .lz-title{font-size:19px;}\n    /* fluid so a long range never wraps on a narrow phone */\n    .lz-calc .lz-price{\n      font-size:clamp(29px, 9.4vw, 40px) !important;letter-spacing:-.022em;white-space:nowrap;\n    }\n    .lz-calc .lz-price .lz-dash{padding:0 4px;}\n    .lz-calc .lz-cards{grid-template-columns:1fr;}\n    .lz-calc .lz-chip{padding:13px 14px;font-size:13.5px;}\n    .lz-calc .lz-chips{gap:7px;}\n    .lz-calc .lz-sticky.lz-show{display:flex;}\n  }\n  @media (prefers-reduced-motion:reduce){ .lz-calc *{transition:none !important;} }\n</style>\n \n  <div class=\"lz-body\">\n    <p class=\"lz-kicker\">Instant Estimate</p>\n    <h2 class=\"lz-title\">What Would Your Redesign Cost?</h2>\n    <p class=\"lz-sub\">Tell me what you have in mind and see a real range straight away &mdash; no email, no waiting.</p>\n \n    <div class=\"lz-step\">\n      <div class=\"lz-step-head\"><span class=\"lz-num\" aria-hidden=\"true\">1</span>\n        <span class=\"lz-label\" id=\"lz-lbl-project\">What would you like made?</span></div>\n      <div class=\"lz-cards\" id=\"lz-project\" role=\"radiogroup\" aria-labelledby=\"lz-lbl-project\"></div>\n    </div>\n    <div class=\"lz-step\">\n      <div class=\"lz-step-head\"><span class=\"lz-num\" aria-hidden=\"true\">2</span>\n        <span class=\"lz-label\" id=\"lz-lbl-metal\">The metal</span></div>\n      <div class=\"lz-chips\" id=\"lz-metal\" role=\"radiogroup\" aria-labelledby=\"lz-lbl-metal\"></div>\n    </div>\n    <div class=\"lz-step\">\n      <div class=\"lz-step-head\"><span class=\"lz-num\" aria-hidden=\"true\">3</span>\n        <span class=\"lz-label\" id=\"lz-lbl-stones\">The stones</span></div>\n      <div class=\"lz-chips\" id=\"lz-stones\" role=\"radiogroup\" aria-labelledby=\"lz-lbl-stones\"></div>\n    </div>\n    <div class=\"lz-step\">\n      <div class=\"lz-step-head\"><span class=\"lz-num\" aria-hidden=\"true\">4</span>\n        <span class=\"lz-label\" id=\"lz-lbl-detail\">How detailed is the design?</span></div>\n      <div class=\"lz-chips\" id=\"lz-detail\" role=\"radiogroup\" aria-labelledby=\"lz-lbl-detail\"></div>\n    </div>\n    <div class=\"lz-step\">\n      <div class=\"lz-step-head\"><span class=\"lz-num\" aria-hidden=\"true\">5</span>\n        <span class=\"lz-label\" id=\"lz-lbl-gold\">How many pieces of old gold or platinum are you sending me?</span></div>\n      <div class=\"lz-chips\" id=\"lz-gold\" role=\"radiogroup\" aria-labelledby=\"lz-lbl-gold\"></div>\n      <p class=\"lz-gold-explain\" id=\"lz-gold-explain\"></p>\n    </div>\n  </div>\n \n  <div class=\"lz-result\" id=\"lz-result\">\n    <p class=\"lz-result-label\" id=\"lz-result-label\">Your estimated range</p>\n    <p class=\"lz-price\" id=\"lz-price\" aria-hidden=\"true\">&mdash;</p>\n    <p class=\"lz-sr\" id=\"lz-sr\" role=\"status\" aria-live=\"polite\"></p>\n    <p class=\"lz-note\" id=\"lz-note\"></p>\n    <div class=\"lz-ledger\" id=\"lz-ledger\" hidden>\n      <div class=\"lz-led-row\"><span>Estimated cost</span><b id=\"lz-led-cost\"></b></div>\n      <div class=\"lz-led-row\"><span>Credit for your gold</span><b id=\"lz-led-credit\"></b></div>\n      <div class=\"lz-led-row lz-led-total\"><span id=\"lz-led-net-label\">Your estimated net</span><b id=\"lz-led-net\"></b></div>\n      <p class=\"lz-led-back\" id=\"lz-led-back\" hidden></p>\n      <div class=\"lz-swing\" id=\"lz-swing\" hidden>\n        <div class=\"lz-swing-bar\"><span class=\"lz-swing-back\" id=\"lz-swing-back\"></span><span class=\"lz-swing-pay\" id=\"lz-swing-pay\"></span></div>\n        <div class=\"lz-swing-ends\"><span id=\"lz-swing-l\"></span><span id=\"lz-swing-r\"></span></div>\n      </div>\n    </div>\n \n    <div class=\"lz-compare\" id=\"lz-compare\" hidden>\n      <div class=\"lz-bar-row\">\n        <div class=\"lz-bar-top\"><span>Your redesign</span><b id=\"lz-bar-mine-v\"></b></div>\n        <div class=\"lz-bar lz-mine\"><span id=\"lz-bar-mine\"></span></div>\n      </div>\n      <div class=\"lz-bar-row\">\n        <div class=\"lz-bar-top\"><span>A comparable piece bought new</span><b id=\"lz-bar-new-v\"></b></div>\n        <div class=\"lz-bar lz-new\"><span id=\"lz-bar-new\"></span></div>\n      </div>\n      <p class=\"lz-saving\" id=\"lz-saving\"></p>\n    </div>\n \n    <div class=\"lz-incl\" id=\"lz-incl\"></div>\n    <a class=\"lz-cta\" id=\"lz-cta\" href=\"#contact\">Get My Exact Quote &mdash; Free</a>\n    <p class=\"lz-timeline\" id=\"lz-timeline\"></p>\n  </div>\n \n  <p class=\"lz-fine\" id=\"lz-fine\"></p>\n \n  <div class=\"lz-sticky\" id=\"lz-sticky\">\n    <span><span class=\"lz-sticky-l\" id=\"lz-sticky-l\">Estimated</span><span class=\"lz-sticky-v\" id=\"lz-sticky-v\">&mdash;</span></span>\n    <button type=\"button\" class=\"lz-sticky-b\" id=\"lz-sticky-b\">See details</button>\n  </div>\n \n<script>\n(function(){\n  /* ==================================================================\n     EDIT YOUR PRICES HERE\n     Placeholders calibrated against ~30 published US sources (2026).\n     ================================================================== */\n  var CONFIG = {\n \n    /* Fonts are still adopted from your theme so the type matches.\n       Colours are NOT - the light palette in the style block above\n       is used as-is. Flip autoThemeColours to true if you'd rather\n       it sample your site's colours again.                          */\n    autoThemeFonts  : true,\n    autoThemeColours: false,\n \n    /* MANUAL FONT OVERRIDE — leave both empty to auto-detect.\n       If detection ever picks the wrong face, paste the exact\n       font-family here and it wins over detection. e.g.\n         fontDisplay: \"'Cormorant Garamond', serif\",\n         fontBody   : \"'Jost', sans-serif\",                     */\n    fontDisplay: \"\",\n    fontBody   : \"\",\n \n    /* THE PRICE FIGURE.\n       700 = bold. Careful: if your display font only ships light and\n       regular weights, the browser fakes a bold, which looks smeared\n       on a serif at this size. So the widget checks whether a real\n       bold exists and, if not, renders the price in your body font\n       (which almost always has one). Override with priceFont.\n         priceFont: \"auto\"     let it decide      (recommended)\n                    \"display\"  force the heading face\n                    \"body\"     force the body face\n       Set priceWeight to 600 for something less heavy, 400 for none. */\n    priceWeight: 700,\n    priceFont  : \"auto\",\n \n    ctaHref  : \"/pages/contact\",  /* selections ride along as ?estimate= */\n    ctaLabel : \"Get My Exact Quote — Free\",\n \n    included : \"Design consultation · CAD drawing for your approval · metalwork · stone setting · finishing and polish\",\n    inclTitle: \"Every estimate includes\",\n    disclaimer: \"These are real ranges based on typical projects, not a binding quote. What moves the final number is the condition of your stones, the finished weight of the metal, and how intricate the design becomes — I confirm all of it with you, in writing, before any work begins.\",\n \n    projects: [\n      /* simple stone transfer: bench labour $75–500 + mounting $290–1,799 */\n      { label:\"Reset my stone into a setting I already have\", desc:\"Labor only — you supply the setting\",\n        lo:150, hi:400, newLo:2150, newHi:3600, weeks:\"1–2 weeks\" },\n      { label:\"Reset my stone into a new ready-made setting\", desc:\"Setting included — the simplest full option\",\n        lo:500, hi:1800, newLo:2500, newHi:5000, weeks:\"2–4 weeks\" },\n      /* custom setting around your stone: $1,500–3,500+ (well evidenced) */\n      { label:\"A custom setting for my stone\", desc:\"Designed from scratch around what you already own\",\n        lo:1500, hi:3500, newLo:4000, newHi:8000, weeks:\"6–9 weeks\" },\n      /* full ring redesign: $1,500–3,000 typical (high confidence) */\n      { label:\"Redesign a ring\", desc:\"Your stones, an entirely new design\",\n        lo:1500, hi:3000, newLo:3500, newHi:7000, weeks:\"6–9 weeks\" },\n      /* band remake: UK £500–1,000 entry, US $550 case study */\n      { label:\"Remake a wedding band\", desc:\"Your gold, reborn as a new band\",\n        lo:450, hi:1200, newLo:700, newHi:2000, weeks:\"4–6 weeks\" },\n      /* simple ring-to-pendant conversion: $50–500 */\n      { label:\"Turn a ring into a pendant or necklace\", desc:\"A simple conversion, keeping its character\",\n        lo:150, hi:600, newLo:800, newHi:2000, weeks:\"2–3 weeks\" },\n      /* melted / recast pendant: £750–1,500 UK ≈ $900–2,200 US */\n      { label:\"A new pendant or necklace from my gold\", desc:\"Melted down and recast as something new\",\n        lo:900, hi:2200, newLo:1500, newHi:3500, weeks:\"6–8 weeks\" },\n      /* true multi-piece combination (recast + reset): $2,500+ */\n      /* custom engagement ring: $2,000–6,000 typical (10+ sources).\n         \"New\" anchored to The Knot's $5,200 US national average.     */\n      /* several pieces into one: $2,000-4,000, the figure already published in\n         this page's own FAQ schema. No newLo/newHi -- there is no honest\n         \"bought new\" equivalent, so the comparison bar stays hidden. */\n      { label:\"Combine several pieces into one\", desc:\"Several heirlooms brought together as one piece\",\n        lo:2000, hi:4000, weeks:\"8\\u201312 weeks\" },\n      { label:\"Custom engagement ring\", desc:\"From scratch, or around your heirloom stone\",\n        lo:2500, hi:6000, newLo:4000, newHi:9000, weeks:\"8–12 weeks\" }\n    ],\n \n    /* metal/gram 2026: 14k $35–50, 18k $50–70, plat $60–90, 3–6g piece */\n    metals: [\n      { label:\"Reuse my own gold\", addLo:0,   addHi:0,    keeps:true },\n      { label:\"New 14k gold\",      addLo:200, addHi:500  },\n      { label:\"New 18k gold\",      addLo:300, addHi:700  },\n      { label:\"Platinum\",          addLo:500, addHi:1100 }\n    ],\n    /* setting $20–100/stone; new 1ct centre $1,500+ lab / $3,400+ natural */\n    stones: [\n      { label:\"Reuse my own stones\",       addLo:0,    addHi:0,    keeps:true },\n      { label:\"Add a few new accents\",     addLo:200,  addHi:800  },\n      { label:\"Source a new centre stone\", addLo:1500, addHi:6000 }\n    ],\n    gold: [\n      { label:\"None (stones only)\", lo:0,    hi:0 },\n      { label:\"1 piece\",     lo:300,  hi:850 },\n      { label:\"2 pieces\",    lo:600,  hi:1700 },\n      { label:\"3 pieces\",    lo:900,  hi:2550 },\n      { label:\"4\\u20135 pieces\", lo:1200, hi:4250 },\n      { label:\"6 or more\",   lo:1800, hi:6000 }\n    ],\n    goldExplain: \"Working with gold you already own is one of my favorite parts of a redesign. It\\u2019s meaningful, kinder to the environment than mining new metal, and genuinely cost-effective \\u2014 because the most valuable part of the piece is already yours. I refine whatever you send and the full settlement comes back to you as a credit; I never take a percentage of it. Send enough and it can cover a good part of the cost, sometimes the whole piece, and sometimes more \\u2014 in which case you\\u2019d get your new jewelry and a check for the difference. I weigh everything and confirm the exact figure with you, in writing, before any work begins.\",\n    backNote: \"Your gold is worth more than this piece costs. You\\u2019d receive your new jewelry and a check for the difference \\u2014 I don\\u2019t keep the balance.\",\n    partNote: \"Your gold comes straight off the cost \\u2014 and the more you send, the further it goes. I never keep any part of the refining payout.\",\n    likelyNote: \"Depending on the final weight and karat, this much gold could cover the whole piece \\u2014 or leave a little to pay. I weigh everything and confirm the exact figure with you in writing before any work begins.\",\n    details: [\n      { label:\"Clean & classic\",    mult:0.9 },\n      { label:\"Moderate detail\",    mult:1.0 },\n      { label:\"Intricate & ornate\", mult:1.3 }\n    ],\n \n    keepsBadge : \"keeps cost down\",\n    savingBoth : \"Reusing your own gold and stones — usually the single biggest cost — saves roughly {AMT} against buying new.\",\n    savingOne  : \"Reusing what you already own saves roughly {AMT} against a comparable new piece.\"\n  };\n  /* ==================== end of editable config ====================== */\n \n  var root  = document.getElementById(\"lz-calc\");\n  var state = { project:3, metal:0, stones:0, detail:1, gold:0 };\n  var reduce = window.matchMedia &&\n               window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n \n  function el(id){ return document.getElementById(id); }\n  function money(n){\n    n = Math.round(n/50)*50;\n    return \"$\" + n.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n  }\n \n  /* ================= AUTO-THEMING FROM THE HOST PAGE =================\n     Samples the live page's colours and adopts them, but only if they\n     pass a contrast check. Nothing here can make the widget\n     unreadable - every value falls back to the built-in palette.     */\n  function rgb(str){\n    var m = String(str||\"\").match(/[\\d.]+/g);\n    if (!m || m.length < 3) return null;\n    if (m.length > 3 && parseFloat(m[3]) < 0.9) return null;   /* skip transparent */\n    return [ +m[0], +m[1], +m[2] ];\n  }\n  function lum(c){\n    var a = c.map(function(v){ v/=255; return v<=0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055,2.4); });\n    return 0.2126*a[0] + 0.7152*a[1] + 0.0722*a[2];\n  }\n  function ratio(a,b){\n    var l1 = lum(a), l2 = lum(b), hi = Math.max(l1,l2), lo = Math.min(l1,l2);\n    return (hi + 0.05) / (lo + 0.05);\n  }\n  function css(c){ return \"rgb(\" + c.map(Math.round).join(\",\") + \")\"; }\n  function mix(a,b,t){ return [0,1,2].map(function(i){ return a[i] + (b[i]-a[i])*t; }); }\n  /* darken until it hits the required contrast against `against` */\n  function ensure(c, need, against){\n    var out = c.slice(), guard = 0;\n    while (ratio(out, against) < need && guard++ < 40){\n      out = mix(out, [0,0,0], 0.08);\n    }\n    return ratio(out, against) >= need ? out : null;\n  }\n  function visible(sel){\n    var list = document.querySelectorAll(sel);\n    for (var i=0;i<list.length;i++){\n      var n = list[i];\n      if (n.offsetParent && n.getBoundingClientRect().width > 20 && !root.contains(n)) return n;\n    }\n    return null;\n  }\n  function bgOf(node){\n    while (node && node !== document.documentElement){\n      var c = rgb(getComputedStyle(node).backgroundColor);\n      if (c) return c;\n      node = node.parentElement;\n    }\n    return rgb(getComputedStyle(document.body).backgroundColor) || [255,255,255];\n  }\n \n  var DIAG = { ran:\"yes\" };\n \n  function applyTheme(){\n    var S = root.style, white = [255,255,255];\n    var doFonts = CONFIG.autoThemeFonts   !== false;\n    var doCol   = CONFIG.autoThemeColours === true;\n    DIAG.mode = (doFonts ? \"fonts adopted\" : \"fonts fixed\") + \" / \" +\n                (doCol ? \"colours adopted\" : \"colours fixed (light palette)\");\n    if (!doFonts && !doCol) return;\n    try {\n      var shell = bgOf(root.parentElement || document.body);\n      var panel = mix(shell, white, 0.35);\n      if (doCol) S.setProperty(\"--lz-shell\", css(panel));\n      DIAG.pageBackground = css(shell);\n \n      var hEl = visible(\"main h2, main h1, article h2, .page-width h2, .rte h2, h2, h1\");\n      var pEl = visible(\"main p, article p, .rte p, .page-width p, p\");\n \n      /* ---------- FONTS ----------\n         A manual override in CONFIG always wins. Otherwise copy the\n         family, weight, case and tracking off your real heading.   */\n      if (CONFIG.fontDisplay){\n        S.setProperty(\"--lz-font-display\", CONFIG.fontDisplay);\n        DIAG.headingFont = CONFIG.fontDisplay + \"   (set manually)\";\n      } else if (doFonts && hEl){\n        var hcs = getComputedStyle(hEl);\n        if (hcs.fontFamily){\n          S.setProperty(\"--lz-font-display\", hcs.fontFamily);\n          DIAG.headingFont = hcs.fontFamily + \"   (from your \" +\n            hEl.tagName.toLowerCase() + \")\";\n        }\n        if (hcs.fontWeight) S.setProperty(\"--lz-title-fw\", hcs.fontWeight);\n        S.setProperty(\"--lz-title-tt\", hcs.textTransform || \"uppercase\");\n        S.setProperty(\"--lz-title-ls\",\n          (hcs.letterSpacing && hcs.letterSpacing !== \"normal\") ? hcs.letterSpacing : \".05em\");\n        DIAG.headingCase   = hcs.textTransform || \"none\";\n        DIAG.headingWeight = hcs.fontWeight;\n      } else if (doFonts){\n        DIAG.headingFont = \"NOT DETECTED — no heading found on the page\";\n      }\n \n      if (CONFIG.fontBody){\n        S.setProperty(\"--lz-font-body\", CONFIG.fontBody);\n        DIAG.bodyFont = CONFIG.fontBody + \"   (set manually)\";\n      } else if (doFonts){\n        var bSrc = pEl || document.body;\n        var bff  = getComputedStyle(bSrc).fontFamily;\n        if (bff){\n          S.setProperty(\"--lz-font-body\", bff);\n          DIAG.bodyFont = bff + \"   (from your \" +\n            (pEl ? \"paragraph text\" : \"page body\") + \")\";\n        } else { DIAG.bodyFont = \"NOT DETECTED\"; }\n      }\n \n      /* Colours stay exactly as the light palette defined in the\n         style block unless autoThemeColours is switched on.        */\n      if (!doCol) return;\n \n      /* ---------- INK: heading colour, darkened if it must be ---------- */\n      var ic = hEl ? rgb(getComputedStyle(hEl).color) : null;\n      if (!ic) ic = rgb(getComputedStyle(document.body).color);\n      if (ic){\n        var ink = ratio(ic, panel) >= 4.5 ? ic : ensure(ic, 7, panel);\n        if (ink){\n          S.setProperty(\"--lz-ink\",   css(ink));\n          S.setProperty(\"--lz-cream\", css(mix(ink, white, 0.92)));\n          S.setProperty(\"--lz-mute\",  css(mix(ink, white, 0.62)));\n          DIAG.headingColour = css(ink);\n        }\n      }\n \n      /* ---------- SECONDARY TEXT ---------- */\n      var pc = pEl ? rgb(getComputedStyle(pEl).color) : null;\n      if (pc){\n        var soft = ratio(pc, panel) >= 4.5 ? pc : ensure(pc, 4.5, panel);\n        if (soft){ S.setProperty(\"--lz-soft\", css(soft)); DIAG.bodyColour = css(soft); }\n      }\n \n      /* ---------- ACCENT: a button fill, else a link colour ----------\n         Unlike v4 this accepts dark buttons and never discards a\n         sample outright - it darkens until white text passes AA.   */\n      var accent = null, from = \"\";\n      var list = document.querySelectorAll(\n        \"button, a.button, .btn, .button, [class*='button'], [type=submit], [class*='Button']\");\n      for (var i=0;i<list.length;i++){\n        var b = list[i];\n        if (root.contains(b) || !b.offsetParent) continue;\n        var r = b.getBoundingClientRect();\n        if (r.width < 70 || r.height < 26) continue;\n        var bc = rgb(getComputedStyle(b).backgroundColor);\n        if (!bc) continue;\n        if (ratio(bc, white) < 1.5) continue;        /* effectively white = not an accent */\n        accent = bc; from = \"a button on the page\"; break;\n      }\n      if (!accent){\n        var a  = visible(\"main a, article a, .rte a, a\");\n        var ac = a ? rgb(getComputedStyle(a).color) : null;\n        if (ac && ratio(ac, panel) > 1.6){ accent = ac; from = \"a link colour\"; }\n      }\n      if (accent){\n        var deep = ratio(accent, white) >= 4.5 ? accent : ensure(accent, 4.5, white);\n        if (deep){\n          S.setProperty(\"--lz-gold-deep\", css(deep));\n          S.setProperty(\"--lz-gold\",      css(mix(deep, white, 0.30)));\n          S.setProperty(\"--lz-gold-lt\",   css(mix(deep, white, 0.50)));\n          S.setProperty(\"--lz-tint\",      css(mix(deep, white, 0.90)));\n          DIAG.accentColour = css(deep) + \"  (from \" + from + \")\";\n        }\n      } else { DIAG.accentColour = \"no button or link found\"; }\n \n      /* ---------- HAIRLINE ---------- */\n      var f  = visible(\"input:not([type=hidden]), textarea, hr, select\");\n      var fc = f ? rgb(getComputedStyle(f).borderTopColor) : null;\n      if (fc && ratio(fc, panel) > 1.08 && ratio(fc, panel) < 5){\n        S.setProperty(\"--lz-line\", css(fc)); DIAG.borderColour = css(fc);\n      }\n    } catch(e){ DIAG.error = String(e && e.message || e); }\n  }\n \n  /* Decide how the price figure is set. Faux-bold on a serif looks\n     smeared, so only keep the display face if it really has the\n     weight; otherwise fall back to the body face.                  */\n  function tunePrice(){\n    var S = root.style, w = CONFIG.priceWeight || 700, pick = CONFIG.priceFont || \"auto\";\n    S.setProperty(\"--lz-price-fw\", w);\n \n    if (pick === \"body\"){\n      S.setProperty(\"--lz-price-font\", \"var(--lz-font-body, inherit)\");\n      DIAG.priceType = \"body font at \" + w + \"  (forced)\";\n      return;\n    }\n    S.removeProperty(\"--lz-price-font\");\n    if (pick === \"display\"){\n      DIAG.priceType = \"heading font at \" + w + \"  (forced)\";\n      return;\n    }\n    var fam   = getComputedStyle(el(\"lz-price\")).fontFamily || \"\";\n    var first = fam.split(\",\")[0].trim().replace(/^[\"']|[\"']$/g, \"\");\n    var real  = false;\n    try { real = !!(document.fonts && document.fonts.check(w + ' 40px \"' + first + '\"')); }\n    catch(e){ real = false; }\n \n    if (real){\n      DIAG.priceType = first + \" has a real \" + w + \" weight — using it\";\n    } else {\n      S.setProperty(\"--lz-price-font\", \"var(--lz-font-body, inherit)\");\n      DIAG.priceType = first + \" has no real \" + w + \" weight — using your body font instead\";\n    }\n  }\n \n  /* Add ?lzdebug=1 to the page URL to see what was detected. */\n  var diagShown = false;\n  function showDiag(){\n    if (diagShown) return;\n    if (!/[?&]lzdebug=1/.test(location.search)) return;\n    diagShown = true;\n    var keys = [\"ran\",\"mode\",\"headingFont\",\"headingWeight\",\"headingCase\",\"bodyFont\",\n                \"pageBackground\",\"headingColour\",\"bodyColour\",\"accentColour\",\n                \"borderColour\",\"priceType\",\"note\",\"error\"];\n    var out = \"LORINCZI ESTIMATOR — THEME DIAGNOSTIC\\n\\n\";\n    for (var i=0;i<keys.length;i++){\n      if (DIAG[keys[i]] === undefined) continue;\n      var k = keys[i]; while (k.length < 16) k += \" \";\n      out += k + \": \" + DIAG[keys[i]] + \"\\n\";\n    }\n    out += \"\\nAnything marked NOT DETECTED or missing above is what\\n\" +\n           \"needs hardcoding. Screenshot this and send it over.\";\n    var d = document.createElement(\"pre\");\n    d.style.cssText = \"font:12px/1.65 ui-monospace,Menlo,Consolas,monospace;\" +\n      \"background:#141210;color:#8fe388;padding:16px 18px;margin:0;white-space:pre-wrap;\";\n    d.textContent = out;\n    root.appendChild(d);\n  }\n \n  /* ---------- radiogroups: roving tabindex + arrow keys ---------- */\n  function buildGroup(id, options, key, kind){\n    var wrap = el(id), nodes = [];\n    options.forEach(function(opt, i){\n      var b = document.createElement(\"button\");\n      b.type = \"button\"; b.setAttribute(\"role\",\"radio\");\n      b.className = (kind === \"card\" ? \"lz-card\" : \"lz-chip\");\n      if (kind === \"card\"){\n        var t = document.createElement(\"span\"); t.className=\"lz-card-t\"; t.textContent=opt.label;\n        var d = document.createElement(\"span\"); d.className=\"lz-card-d\"; d.textContent=opt.desc||\"\";\n        b.appendChild(t); b.appendChild(d);\n        b.setAttribute(\"aria-label\", opt.label + (opt.desc ? \". \" + opt.desc : \"\"));\n      } else {\n        b.appendChild(document.createTextNode(opt.label));\n        if (opt.keeps && CONFIG.keepsBadge){\n          var k = document.createElement(\"span\"); k.className=\"lz-keep\";\n          k.textContent = \"· \" + CONFIG.keepsBadge; b.appendChild(k);\n        }\n      }\n      b.addEventListener(\"click\", function(){ select(i,false); noteInteraction(); });\n      b.addEventListener(\"keydown\", function(e){\n        var d = 0;\n        if (e.key===\"ArrowRight\"||e.key===\"ArrowDown\") d = 1;\n        else if (e.key===\"ArrowLeft\"||e.key===\"ArrowUp\") d = -1;\n        else return;\n        e.preventDefault();\n        select((i + d + options.length) % options.length, true);\n        noteInteraction();\n      });\n      nodes.push(b); wrap.appendChild(b);\n    });\n    function select(i, focus){\n      state[key] = i;\n      nodes.forEach(function(n,k){\n        var on = (k===i);\n        n.classList.toggle(\"lz-on\", on);\n        n.setAttribute(\"aria-checked\", on ? \"true\":\"false\");\n        n.tabIndex = on ? 0 : -1;\n      });\n      if (focus) nodes[i].focus();\n      render();\n    }\n    select(state[key], false);\n  }\n \n  /* ---------- animated number ---------- */\n  var shown = { lo:null, hi:null }, raf = null;\n  var plusOn = true;\n  function paint(lo, hi){\n    var a = money(lo), b = money(hi);\n    var html = (a === b) ? a : (a + '<span class=\"lz-dash\">&ndash;</span>' + b);\n    el(\"lz-price\").innerHTML    = html + (plusOn ? '<span class=\"lz-plus\">+</span>' : '');\n    el(\"lz-sticky-v\").innerHTML = html;\n  }\n  function animateTo(lo, hi){\n    if (shown.lo === null || reduce){ shown.lo=lo; shown.hi=hi; paint(lo,hi); return; }\n    var a=shown.lo, b=shown.hi, t0=null, dur=400;\n    if (raf) cancelAnimationFrame(raf);\n    function frame(ts){\n      if (t0===null) t0=ts;\n      var p = Math.min(1,(ts-t0)/dur), e = 1-Math.pow(1-p,3);\n      paint(a+(lo-a)*e, b+(hi-b)*e);\n      if (p<1) raf = requestAnimationFrame(frame); else { shown.lo=lo; shown.hi=hi; }\n    }\n    raf = requestAnimationFrame(frame);\n  }\n \n  /* What the contact form's message box gets prefilled with. Kept here rather\n     than on the contact page so the option labels live in one place — the\n     receiving end (assets/contact-form-prefill.js) just drops the text in. */\n  function estimateSummary(p, m, s, d, lo, hi, g, screenLine){\n    return \"Hi Stacey \\u2014 I used the instant estimate on your site and picked:\\n\\n\"\n         + \"Project: \" + p.label + \"\\n\"\n         + \"Metal: \"   + m.label + \"\\n\"\n         + \"Stones: \"  + s.label + \"\\n\"\n         + \"Detail: \"  + d.label + \"\\n\"\n         + \"Gold/platinum to refine: \" + g.label + \"\\n\"\n         + \"Estimated cost before credit: \" + money(lo) + \" \\u2013 \" + money(hi) + \"\\n\"\n         + (g.hi > 0 ? \"Possible refining credit: \" + money(g.lo) + \" \\u2013 \" + money(g.hi) + \" (not yet weighed)\\n\" : \"\")\n         + \"Figure on my screen: \" + screenLine + \"\\n\\n\"\n         + \"More about my piece:\\n\";\n  }\n\n  function render(){\n    var p = CONFIG.projects[state.project], m = CONFIG.metals[state.metal],\n        s = CONFIG.stones[state.stones],   d = CONFIG.details[state.detail];\n    var g  = CONFIG.gold[state.gold] || CONFIG.gold[0];\n    var lo = (p.lo + m.addLo + s.addLo) * d.mult;\n    var hi = (p.hi + m.addHi + s.addHi) * d.mult;\n    var netLo = lo - g.hi, netHi = hi - g.lo;\n    var backLo = -netHi, backHi = -netLo;\n    var hasGold  = (g.hi > 0);\n    var allBack  = hasGold && netHi <= 0;\n    var straddle = hasGold && netLo < 0 && netHi > 0;\n    var showLo, showHi;\n    if (allBack){ showLo = backLo; showHi = backHi; }\n    else if (straddle){ showLo = backHi; showHi = backHi; }\n    else { showLo = Math.max(0, netLo); showHi = Math.max(0, netHi); }\n    /* Exactly what the headline figure says, so the prefilled email can quote it\n       back. It used to send the gross cost instead, so whenever gold was chosen\n       I was told a different number than the one she was looking at. */\n    var screenLine = !hasGold ? (money(lo) + \" \\u2013 \" + money(hi))\n      : allBack  ? (\"take home \" + money(backLo) + \" \\u2013 \" + money(backHi))\n      : straddle ? (\"take home up to \" + money(backHi) + \", or pay up to \" + money(netHi))\n      :            (money(Math.max(0, netLo)) + \" \\u2013 \" + money(Math.max(0, netHi)));\n    lastCalc = { lo: Math.round(lo), hi: Math.round(hi), line: screenLine,\n      outcome: !hasGold ? \"no_gold\" : allBack ? \"all_back\" : straddle ? \"straddle\" : \"pay_after_credit\" };\n    var cmpMid = (Math.max(0, netLo) + Math.max(0, netHi))/2;\n \n    var led = el(\"lz-ledger\"), res = el(\"lz-result\"), rlbl = el(\"lz-result-label\"), sw = el(\"lz-swing\"), stk = el(\"lz-sticky\");\n    if (hasGold){\n      led.hidden = false;\n      el(\"lz-led-cost\").textContent   = money(lo) + \" \\u2013 \" + money(hi);\n      el(\"lz-led-credit\").textContent = \"\\u2212\" + money(g.lo) + \" \\u2013 \\u2212\" + money(g.hi);\n      if (allBack){\n        res.classList.add(\"lz-back\"); sw.hidden = true;\n        stk.classList.add(\"lz-back\"); el(\"lz-sticky-l\").textContent = \"You take home\";\n        rlbl.textContent = \"You could take home\";\n        el(\"lz-led-net-label\").textContent = \"You could take home\";\n        el(\"lz-led-net\").textContent = money(backLo) + \" \\u2013 \" + money(backHi);\n        el(\"lz-led-back\").hidden = false; el(\"lz-led-back\").textContent = CONFIG.backNote;\n      } else if (straddle){\n        res.classList.add(\"lz-back\"); sw.hidden = false;\n        stk.classList.add(\"lz-back\"); el(\"lz-sticky-l\").textContent = \"You take home up to\";\n        rlbl.textContent = \"You could take home up to\";\n        el(\"lz-led-net-label\").textContent = \"You could take home up to\";\n        el(\"lz-led-net\").textContent = money(backHi);\n        var tot = backHi + netHi;\n        el(\"lz-swing-back\").style.width = (backHi/tot*100).toFixed(1) + \"%\";\n        el(\"lz-swing-pay\").style.width  = (netHi/tot*100).toFixed(1) + \"%\";\n        el(\"lz-swing-l\").textContent = \"take home \" + money(backHi);\n        el(\"lz-swing-r\").textContent = \"or pay \" + money(netHi);\n        el(\"lz-led-back\").hidden = false; el(\"lz-led-back\").textContent = CONFIG.likelyNote;\n      } else {\n        res.classList.remove(\"lz-back\"); sw.hidden = true;\n        stk.classList.remove(\"lz-back\"); el(\"lz-sticky-l\").textContent = \"Estimated\";\n        rlbl.textContent = \"Your estimated range\";\n        el(\"lz-led-net-label\").textContent = \"Your estimated net\";\n        el(\"lz-led-net\").textContent = money(netLo) + \" \\u2013 \" + money(netHi);\n        el(\"lz-led-back\").hidden = false; el(\"lz-led-back\").textContent = CONFIG.partNote;\n      }\n    } else {\n      led.hidden = true; sw.hidden = true; el(\"lz-led-back\").hidden = true;\n      res.classList.remove(\"lz-back\"); rlbl.textContent = \"Your estimated range\";\n      stk.classList.remove(\"lz-back\"); el(\"lz-sticky-l\").textContent = \"Estimated\";\n    }\n \n    plusOn = !(allBack || straddle);\n    animateTo(showLo, showHi);\n    el(\"lz-sr\").textContent = (allBack || straddle)\n      ? (\"You could take home \" + (allBack ? (money(backLo) + \" to \" + money(backHi))\n                                          : (\"up to \" + money(backHi))) + \".\")\n      : (\"Estimated range \" + money(showLo) + \" to \" + money(showHi)\n         + (hasGold ? \", after credit for your gold.\" : \" or more.\"));\n    el(\"lz-note\").textContent = p.desc || \"\";\n    el(\"lz-timeline\").textContent = p.weeks ? (\"Typically ready in \" + p.weeks + \".\") : \"\";\n \n    var cmp = el(\"lz-compare\"), reuse = m.keeps || s.keeps;\n    var midMine = cmpMid, midNew = ((p.newLo||0)+(p.newHi||0))/2;\n    var adjNew  = midNew + (s.addLo + s.addHi + m.addLo + m.addHi)/2;\n \n    if (reuse && midNew > 0 && adjNew > midMine*1.08){\n      cmp.hidden = false;\n      el(\"lz-bar-mine\").style.width = ((midMine/adjNew)*100).toFixed(1) + \"%\";\n      el(\"lz-bar-new\").style.width  = \"100%\";\n      el(\"lz-bar-mine-v\").textContent = money(midMine);\n      el(\"lz-bar-new-v\").textContent  = money(adjNew);\n      el(\"lz-saving\").textContent =\n        (m.keeps && s.keeps ? CONFIG.savingBoth : CONFIG.savingOne)\n          .replace(\"{AMT}\", money(adjNew - midMine));\n    } else {\n      cmp.hidden = true;\n      el(\"lz-bar-mine\").style.width = \"0%\";\n      el(\"lz-bar-new\").style.width  = \"0%\";\n    }\n\n    if (cta && CONFIG.ctaHref.charAt(0) !== \"#\"){\n      cta.href = CONFIG.ctaHref\n               + (CONFIG.ctaHref.indexOf(\"?\") === -1 ? \"?\" : \"&\")\n               + \"estimate=\" + encodeURIComponent(estimateSummary(p, m, s, d, lo, hi, g, screenLine));\n    }\n  }\n \n  /* ---------- analytics ----------\n     GA4 here is a sandboxed Shopify web pixel, so gtag() is not reachable from\n     theme scope. Load our own with send_page_view:false, and only once someone\n     actually touches the widget -- anyone who scrolls past downloads nothing.\n     Same approach as assets/contact-form-tracking.js. */\n  var GA_ID = \"G-NL5P1911ZX\", gaLoaded = false, estStarted = false,\n      ctaSent = false, estStartedAt = 0, lastCalc = {};\n  function gtag(){ (window.dataLayer = window.dataLayer || []).push(arguments); }\n  function loadGA(){\n    if (gaLoaded) return; gaLoaded = true;\n    if (window.google_tag_manager && window.google_tag_manager[GA_ID]) return;\n    var s = document.createElement(\"script\"); s.async = true;\n    s.src = \"https://www.googletagmanager.com/gtag/js?id=\" + GA_ID;\n    document.head.appendChild(s);\n    gtag(\"js\", new Date()); gtag(\"config\", GA_ID, { send_page_view:false });\n  }\n  function track(name, extra){\n    loadGA();\n    var g = CONFIG.gold[state.gold] || CONFIG.gold[0], p = {\n      est_project: CONFIG.projects[state.project].label,\n      est_metal:   CONFIG.metals[state.metal].label,\n      est_stones:  CONFIG.stones[state.stones].label,\n      est_detail:  CONFIG.details[state.detail].label,\n      est_refine:  g.label,\n      est_outcome: lastCalc.outcome || \"\",\n      page_location: location.href, page_path: location.pathname\n    };\n    for (var k in extra) if (Object.prototype.hasOwnProperty.call(extra,k)) p[k] = extra[k];\n    gtag(\"event\", name, p);\n  }\n  /* Only fires for a real click or keypress -- buildGroup also calls select()\n     once at init to paint the defaults, and that must not count as a start. */\n  function noteInteraction(){\n    if (estStarted) return;\n    estStarted = true; estStartedAt = Date.now();\n    track(\"estimator_start\", {});\n  }\n  function reportAbandon(){\n    if (!estStarted || ctaSent) return;\n    ctaSent = true;\n    track(\"estimator_abandon\", { seconds_on_widget: Math.round((Date.now() - estStartedAt)/1000) });\n  }\n  document.addEventListener(\"visibilitychange\", function(){\n    if (document.visibilityState === \"hidden\") reportAbandon();\n  });\n  window.addEventListener(\"pagehide\", reportAbandon);\n \n  /* ---------- init ---------- */\n  applyTheme();\n  tunePrice();\n \n  buildGroup(\"lz-project\", CONFIG.projects, \"project\", \"card\");\n  buildGroup(\"lz-metal\",   CONFIG.metals,   \"metal\",   \"chip\");\n  buildGroup(\"lz-stones\",  CONFIG.stones,   \"stones\",  \"chip\");\n  buildGroup(\"lz-detail\",  CONFIG.details,  \"detail\",  \"chip\");\n  buildGroup(\"lz-gold\",    CONFIG.gold,     \"gold\",    \"chip\");\n  el(\"lz-gold-explain\").textContent = CONFIG.goldExplain;\n \n  el(\"lz-incl\").innerHTML  = \"<b>\" + CONFIG.inclTitle + \"</b>\" + CONFIG.included;\n  el(\"lz-fine\").textContent = CONFIG.disclaimer;\n \n  var cta = el(\"lz-cta\");\n  cta.addEventListener(\"click\", function(){\n    if (ctaSent) return; ctaSent = true;\n    track(\"estimator_cta_click\", {\n      est_cost_low: lastCalc.lo, est_cost_high: lastCalc.hi,\n      est_screen_figure: lastCalc.line,\n      seconds_on_widget: estStarted ? Math.round((Date.now() - estStartedAt)/1000) : 0\n    });\n  });\n  cta.href = CONFIG.ctaHref; cta.textContent = CONFIG.ctaLabel;\n  cta.addEventListener(\"click\", function(e){\n    if (CONFIG.ctaHref.charAt(0) !== \"#\") return;\n    var t = document.querySelector(CONFIG.ctaHref);\n    if (!t) return;\n    e.preventDefault();\n    t.scrollIntoView({ behavior: reduce ? \"auto\":\"smooth\", block:\"start\" });\n  });\n  el(\"lz-sticky-b\").addEventListener(\"click\", function(){\n    el(\"lz-result\").scrollIntoView({ behavior: reduce ? \"auto\":\"smooth\", block:\"center\" });\n  });\n \n  (function(){\n    var bar = el(\"lz-sticky\");\n    if (!(\"IntersectionObserver\" in window)) return;\n    var inWidget = false, resultSeen = false;\n    function sync(){ bar.classList.toggle(\"lz-show\", inWidget && !resultSeen); }\n    new IntersectionObserver(function(es){ inWidget = es[0].isIntersecting; sync(); },\n      { threshold:0 }).observe(root);\n    new IntersectionObserver(function(es){ resultSeen = es[0].isIntersecting; sync(); },\n      { threshold:0.12 }).observe(el(\"lz-result\"));\n  })();\n \n  /* Re-sample a few times. Three things can arrive after this script\n     first runs: web fonts finishing loading, sections further down the\n     page (headings below the widget don't exist yet at parse time),\n     and themes that swap fonts in via JS.                            */\n  function refresh(){ applyTheme(); tunePrice(); }\n  if (document.fonts && document.fonts.ready)\n    document.fonts.ready.then(function(){ refresh(); showDiag(); });\n  window.addEventListener(\"load\", function(){ refresh(); showDiag(); });\n  setTimeout(refresh, 400);\n  setTimeout(function(){ refresh(); showDiag(); }, 1600);\n  showDiag();\n \n  render();\n})();\n</script>\n</div>\n<!-- ================= WIDGET END - copy to here ================= -->",
