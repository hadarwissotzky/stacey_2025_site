      "settings": {
        "custom_liquid": "<!-- ================= WIDGET START - copy from here ================= -->\n<div class=\"lz-calc\" id=\"lz-calc\">\n<style>\n  .lz-calc{\n    /* ---------- LIGHT PALETTE ----------\n       No dark panels anywhere. Change these nine to retune it.   */\n    --lz-ink:#3a332c;        /* headings + figures (soft, not black) */\n    --lz-soft:#736a60;       /* secondary text                       */\n    --lz-gold:#b08d55;       /* accent hairlines, borders            */\n    --lz-gold-deep:#836638;  /* the one solid fill: the CTA          */\n    --lz-tint:#f8f2e7;       /* selected wash + result panel         */\n    --lz-line:#e9e0d2;       /* hairlines                            */\n    --lz-shell:#fffefc;      /* widget background                    */\n    --lz-cream:#f3ece1;\n    --lz-gold-lt:#d9c49b;    /* muted bar fill                       */\n    --lz-mute:#9c9287;\n \n    max-width:1000px; margin:0 auto;   /* 15% wider than the 740px original */\n    background:var(--lz-shell);\n    border:1px solid var(--lz-line);\n    color:var(--lz-ink);\n    font-family:var(--lz-font-body, inherit);\n    font-size:16px; line-height:1.5; text-align:left;\n  }\n  .lz-calc *{box-sizing:border-box;}\n  .lz-calc button{font:inherit;color:inherit;margin:0;}\n  .lz-calc .lz-body{padding:44px 40px 34px;}\n \n  .lz-calc .lz-kicker{\n    font-size:11px;letter-spacing:.24em;text-transform:uppercase;\n    color:var(--lz-gold-deep);text-align:center;margin:0 0 12px;\n  }\n  /* caps, to match the section headings already on your page */\n  .lz-calc .lz-title{\n    font-family:var(--lz-font-display, inherit);\n    font-size:25px;font-weight:var(--lz-title-fw, 400);\n    letter-spacing:var(--lz-title-ls, .05em);\n    text-transform:var(--lz-title-tt, uppercase);\n    text-align:center;margin:0 0 12px;line-height:1.3;\n  }\n  .lz-calc .lz-sub{\n    text-align:center;color:var(--lz-soft);font-size:15px;\n    margin:0 auto 32px;max-width:46ch;\n  }\n \n  .lz-calc .lz-step{margin-bottom:26px;}\n  .lz-calc .lz-step:last-child{margin-bottom:0;}\n  .lz-calc .lz-step-head{display:flex;align-items:baseline;gap:10px;margin-bottom:12px;}\n  .lz-calc .lz-num{\n    font-size:10px;letter-spacing:.14em;color:var(--lz-gold-deep);\n    border:1px solid var(--lz-line);border-radius:50%;\n    width:22px;height:22px;flex:0 0 22px;\n    display:flex;align-items:center;justify-content:center;\n    font-variant-numeric:tabular-nums;\n  }\n  .lz-calc .lz-label{font-size:11px;letter-spacing:.18em;text-transform:uppercase;}\n \n  .lz-calc .lz-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;}\n  .lz-calc .lz-card{\n    position:relative;text-align:left;cursor:pointer;\n    background:var(--lz-shell);border:1px solid var(--lz-line);\n    padding:14px 15px 13px 17px;\n    display:flex;flex-direction:column;gap:3px;min-height:70px;\n    transition:border-color .16s ease, background .16s ease;\n  }\n  .lz-calc .lz-card::before{\n    content:\"\";position:absolute;left:0;top:0;bottom:0;width:2px;\n    background:transparent;transition:background .16s ease;\n  }\n  .lz-calc .lz-card:hover{border-color:var(--lz-gold);}\n  .lz-calc .lz-card.lz-on{border-color:var(--lz-gold-deep);background:var(--lz-tint);}\n  .lz-calc .lz-card.lz-on::before{background:var(--lz-gold-deep);}\n  .lz-calc .lz-card-t{font-size:14.5px;line-height:1.3;}\n  .lz-calc .lz-card-d{font-size:12px;line-height:1.4;color:var(--lz-soft);}\n \n  .lz-calc .lz-chips{display:flex;flex-wrap:wrap;gap:8px;}\n  .lz-calc .lz-chip{\n    cursor:pointer;background:var(--lz-shell);border:1px solid var(--lz-line);\n    padding:10px 15px;font-size:14px;line-height:1.2;white-space:nowrap;\n    transition:border-color .16s ease, background .16s ease, color .16s ease;\n  }\n  .lz-calc .lz-chip:hover{border-color:var(--lz-gold);}\n  /* selected = warm wash + doubled gold rule, never a dark fill */\n  .lz-calc .lz-chip.lz-on{\n    background:var(--lz-tint);border-color:var(--lz-gold);\n    box-shadow